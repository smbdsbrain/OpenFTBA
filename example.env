# Copy to .env and edit. Only OPENFTBA_TRACKS really needs setting.

# Host port to expose the web UI / API on.
OPENFTBA_WEB_PORT=5412

# Absolute path to the folder OpenTracks auto-exports .kmz files to.
# Mounted read-only into the container. (Use an absolute path.)
OPENFTBA_TRACKS=/path/to/opentracks/export

# Optional: folder of SRTM .hgt/.hgt.gz tiles (1 deg each) for elevation
# correction. Leave the default if you have none and keep USE_DEM=false.
OPENFTBA_DEM=./dem
OPENFTBA_USE_DEM=false

# How often (seconds) the server rescans the folder for new exports.
OPENFTBA_RESCAN_SECONDS=60

# --- Optional defaults. These are also editable in the in-app Settings, which
#     persist server-side; values here only seed the first run. ---
# OPENFTBA_UNITS=METRIC          # METRIC | IMPERIAL
# OPENFTBA_LANG=en               # en | ru
# OPENFTBA_IGNORE_ELEVATION=false
# OPENFTBA_DISABLED_CHANNELS=    # comma list: HEART_RATE,CADENCE,POWER,SPEED,ELEVATION
# Athlete profile (enables power/HR-based intensity and the W/kg athlete scale):
# OPENFTBA_WEIGHT_KG=75
# OPENFTBA_FTP=220
# OPENFTBA_MAX_HR=190
# OPENFTBA_REST_HR=60
# OPENFTBA_SEX=UNSPECIFIED       # MALE | FEMALE | UNSPECIFIED
