# Normalize line endings: LF in the repo for everything text.
* text=auto eol=lf

# Windows batch scripts need CRLF.
*.bat text eol=crlf

# The Gradle wrapper script must stay LF so it runs on Linux/macOS.
gradlew text eol=lf

# Binary assets — never touch.
*.jar binary
*.hgt binary
*.gz  binary
*.kmz binary
*.kml binary
*.gpx binary
*.png binary
